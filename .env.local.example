# TE2SR frontend — copy to `.env.local` and fill in
# Google OAuth 2.0 web client id (public; baked into the client bundle)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# Base URL of the backend API. Local dev: http://localhost:8787 — Production: https://te2sr.com
NEXT_PUBLIC_API_URL="http://localhost:8787"
