# ══════════════════════════════════════════════════════════════
#  TE2SR backend — copy to `.env` and fill in real values
# ══════════════════════════════════════════════════════════════

# MySQL connection string (Aiven / PlanetScale / any MySQL 8)
DATABASE_URL=mysql://user:password@host:port/database?ssl-mode=REQUIRED
# Path to the CA certificate for TLS (Aiven provides one). Leave blank to skip custom CA.
DB_CA_PATH=./certs/aiven-ca.pem

# Session signing secret — generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Emails auto-granted the admin role (comma separated)
ADMIN_EMAILS=you@example.com

# Google OAuth 2.0 web client id (optional; validates Google id_token audience)
GOOGLE_CLIENT_ID=

# CORS allowed origins (comma separated) or *
ALLOWED_ORIGINS=http://localhost:3000

# HTTP port
PORT=8787

# Cloudflare Email Sending (optional transactional email)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MAIL_FROM=admin@te2sr.com
MAIL_FROM_NAME=TE2SR
MAIL_ADMIN=admin@te2sr.com
